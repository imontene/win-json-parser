<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wjson.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <!-- One row of the comparison results (DiffItem in MainWindow.xaml.cs). -->
            <DataTemplate x:Key="DiffItemTemplate">
                <Grid ColumnSpacing="10" Padding="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Mark}"
                        Foreground="{Binding MarkBrush}"
                        FontFamily="Cascadia Mono, Consolas"
                        FontWeight="Bold"
                        VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Pointer}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding Detail}"
                            FontFamily="Cascadia Mono, Consolas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar x:Name="Toolbar" Grid.Row="0" HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" Click="Open_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="SaveButton" Icon="Save" Click="Save_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="SaveAsButton" Icon="SaveLocal" Click="SaveAs_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="FormatButton" Icon="AlignLeft" Click="Format_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="MinifyButton" Click="Minify_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton x:Name="JsoncToggle" Icon="Comment" Click="Jsonc_Click" />
            <AppBarSeparator />
            <AppBarButton x:Name="CompareButton" Click="Compare_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8AB;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- Editor | tree -->
        <Grid Grid.Row="1" Padding="12,0,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="200" />
                <ColumnDefinition Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Syntax colors, undo/redo and the link with the tree are handled in code. -->
            <RichEditBox
                x:Name="Editor"
                Grid.Column="0"
                TextWrapping="NoWrap"
                IsSpellCheckEnabled="False"
                IsTextPredictionEnabled="False"
                ClipboardCopyFormat="PlainText"
                DisabledFormattingAccelerators="All"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                TextChanged="Editor_TextChanged"
                SelectionChanged="Editor_SelectionChanged"
                Paste="Editor_Paste"
                PreviewKeyDown="Editor_PreviewKeyDown" />

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PointerBox" FontFamily="Cascadia Mono, Consolas" KeyDown="PointerBox_KeyDown" />
                    <Button x:Name="GoButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="Go_Click" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <!-- Drag settings are applied in code. -->
                    <TreeView
                        x:Name="Tree"
                        SelectionMode="Single"
                        Expanding="Tree_Expanding"
                        ItemInvoked="Tree_ItemInvoked">
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Content.Label}" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding Content.ValueText}"
                                        Foreground="{Binding Content.ValueBrush}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <!-- Selected node -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="SelectionText"
                        VerticalAlignment="Center"
                        FontFamily="Cascadia Mono, Consolas"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CopyPointerButton" Grid.Column="1" IsEnabled="False" Click="CopyPointer_Click" />
                    <Button x:Name="CopyValueButton" Grid.Column="2" IsEnabled="False" Click="CopyValue_Click" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Progress while opening or comparing large files -->
        <Border
            x:Name="BusyPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="360"
            Padding="24,20"
            Visibility="Collapsed"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Spacing="12">
                <TextBlock x:Name="BusyText" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="480" />
                <ProgressBar x:Name="BusyProgress" IsIndeterminate="True" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="BusyElapsed"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="BusyCancelButton" Grid.Column="1" Click="BusyCancel_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Grid
            Grid.Row="2"
            Padding="12,6"
            ColumnSpacing="10"
            Background="{ThemeResource LayerFillColorAltBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="StatusIcon" FontSize="14" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <HyperlinkButton x:Name="GoToErrorButton" Grid.Column="2" Padding="6,2" Visibility="Collapsed" Click="GoToError_Click" />
            <TextBlock
                x:Name="InfoText"
                Grid.Column="4"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
