<Project Sdk="Microsoft.NET.Sdk">

  <!--
    wjson Viewer: WinUI 3 desktop app, unpackaged and self-contained (no
    Windows App SDK runtime or .NET install needed). Build on Windows:
      dotnet publish gui/Wjson.Viewer -c Release -r win-x64 -p:Platform=x64
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wjson.Viewer</RootNamespace>
    <AssemblyName>WjsonViewer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <Product>wjson Viewer</Product>
    <Copyright>(c) 2026 imontene and win-json-parser contributors. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Wjson.Viewer.Core/Wjson.Viewer.Core.csproj" />
  </ItemGroup>

</Project>
